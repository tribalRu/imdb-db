# Copy this file to backend/app/.env and adjust for your machine.
# It is loaded by `uvicorn main:app` (run from backend/app) and by the CLI.
# Alembic also reads backend/app/.env directly.

DATABASE_URL=postgresql+asyncpg://imdb-db:secret123@localhost:5432/imdb-db
DATABASE_URL_SYNC=postgresql://imdb-db:secret123@localhost:5432/imdb-db

# Relative paths are resolved against the repository root.
CACHE_DIR=data/cache
FRONTEND_DIST=frontend/dist

# Optional settings
# API_TOKEN=change-me
# DATASET_TO_KEEP=2
# GIT_TAG=dev
# GIT_COMMIT=local
